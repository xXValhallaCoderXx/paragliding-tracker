    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-location": "~57.0.11",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-sensors": "~57.0.2",
    "expo-sharing": "~57.0.13",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.11",
    "expo-web-browser": "~57.0.2",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest-expo": "~57.0.4",
    "lightningcss": "1.30.1",
    "tailwindcss": "4.2.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --localhost --dev-client",
    "start:lan": "expo start --lan --dev-client",
    "start:tunnel": "expo start --tunnel --dev-client",
    "android": "REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo run:android --device",
    "android:no-bundler": "REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo run:android --device --no-bundler",
    "android:release": "cd android && ./gradlew :app:assembleRelease",
    "android:release:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "validate:deps": "expo install --check",
    "db:push": "pnpm dlx supabase@latest db push",
    "db:diff": "pnpm dlx supabase@latest db diff",
    "db:test": "pnpm dlx supabase@latest test db",
    "fn:deploy": "pnpm dlx supabase@latest functions deploy delete-account"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "private": true
}

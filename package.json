  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo/metro-runtime": "~57.0.11",
    "@expo/ui": "~57.0.11",
    "@reduxjs/toolkit": "^2.12.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.14",
    "expo-battery": "~57.0.2",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.13",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-location": "~57.0.11",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-sensors": "~57.0.2",
    "expo-sharing": "~57.0.13",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.11",
    "expo-web-browser": "~57.0.2",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-dynamic-import": "7.29.7",
    "@tailwindcss/postcss": "4.2.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest-expo": "~57.0.4",
    "lightningcss": "1.30.1",
    "supabase": "2.116.0",
    "tailwindcss": "4.2.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --localhost --dev-client",
    "start:lan": "expo start --lan --dev-client",
    "start:tunnel": "expo start --tunnel --dev-client",
    "android": "REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo run:android --device",
    "android:no-bundler": "REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo run:android --device --no-bundler",
    "android:release": "cd android && ./gradlew :app:assembleRelease",
    "android:release:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "android:reset-data": "adb shell pm clear com.xxvalhallacoderxx.xcmvp",
    "android:reset-db": "adb shell am force-stop com.xxvalhallacoderxx.xcmvp && adb shell run-as com.xxvalhallacoderxx.xcmvp rm -f files/SQLite/xc-recorder.db files/SQLite/xc-recorder.db-wal files/SQLite/xc-recorder.db-shm",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "validate:deps": "expo install --check",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:test": "node scripts/test-db.mjs",
    "fn:deploy": "supabase functions deploy delete-account",
    "test:types": "node scripts/test.mjs types",
    "test:lint": "node scripts/test.mjs lint",
    "test:unit": "node scripts/test.mjs unit",
    "test:db": "node scripts/test.mjs db",
    "db:types": "node scripts/test-db.mjs --update-types",
    "test:regressions": "node scripts/check-test-regressions.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
